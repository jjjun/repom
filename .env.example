# Repom Configuration Example
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# .env is excluded from git. .env.example is committed as a reference.

# -----------------------------------------------------------------------
# Core Settings
# -----------------------------------------------------------------------

# Execution environment: dev | test | prod
EXEC_ENV=dev

# CONFIG_HOOK: module path, optionally followed by :callable (defaults to hook_config).
# This active repository hook selects PostgreSQL for dev/prod and in-memory SQLite for test.
CONFIG_HOOK=repom.config_hook:hook_config
# External projects must replace this with their own hook, especially for Alembic model discovery.
# CONFIG_HOOK=mine_py.config:get_repom_config

# -----------------------------------------------------------------------
# Database (SQLite: selected for test by the repository hook)
# -----------------------------------------------------------------------

# SQLITE_DB_PATH=data
# SQLITE_DB_FILE=app_dev.sqlite3
# SQLITE_USE_IN_MEMORY_FOR_TESTS=true
# SQLITE_USE_FILE_DB=true  # Disable the in-memory SQLite default for test.

# -----------------------------------------------------------------------
# Database (PostgreSQL — set DB_TYPE=postgres to enable)
# -----------------------------------------------------------------------

# DB_TYPE=postgres
# REPOM_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/app_dev
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/app_dev  # Fallback URL when REPOM_DATABASE_URL is unset.

# CHANGE_ME is a non-functional placeholder: postgres_generate / redis_generate
# refuse it (and an empty REDIS_PASSWORD), so copying this file verbatim fails
# loudly instead of standing up a service with a known password.
# POSTGRES_USER=repom
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# REPOM_POSTGRES_DB=repom  # PostgreSQL database name used by PostgreSQL scripts.
# POSTGRES_HOST_PORT=5432  # Host port published for the PostgreSQL container.
# POSTGRES_EXPOSE_TO_LAN=false  # Publish PostgreSQL on LAN interfaces instead of loopback.

# -----------------------------------------------------------------------
# pgAdmin (optional, only used when PostgreSQL is enabled)
# -----------------------------------------------------------------------

# PGADMIN_DEFAULT_EMAIL=admin@example.com
# PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
# PGADMIN_HOST_PORT=5050  # Host port published for the pgAdmin container.
# PGADMIN_EXPOSE_TO_LAN=false  # Publish pgAdmin on LAN interfaces instead of loopback.

# -----------------------------------------------------------------------
# Redis (optional)
# -----------------------------------------------------------------------

# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_HOST_PORT=6379  # Host port for Redis; when unset, it follows REDIS_PORT.
# REDIS_EXPOSE_TO_LAN=false  # Publish Redis on LAN interfaces instead of loopback.

# -----------------------------------------------------------------------
# SQLAlchemy Diagnostics (optional)
# -----------------------------------------------------------------------

# SQLALCHEMY_ECHO=false
# SQLALCHEMY_ECHO_LEVEL=INFO
# SQLALCHEMY_HIDE_PARAMETERS=true
# SQLALCHEMY_POOL_SIZE=5  # Number of persistent connections in the SQLAlchemy pool.
# SQLALCHEMY_MAX_OVERFLOW=10  # Extra connections allowed above the pool size.
# SQLALCHEMY_POOL_TIMEOUT=30  # Seconds to wait for a pooled connection.
# SQLALCHEMY_POOL_RECYCLE=3600  # Seconds before a pooled connection is recycled; -1 disables recycling.
# SQLALCHEMY_POOL_PRE_PING=true  # Check pooled connections before using them.
